{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "base", "name": "White", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Lab Navy", "color": "#0F1B2D" },
				{ "slug": "navy-raised", "name": "Navy Raised", "color": "#16243A" },
				{ "slug": "contrast-2", "name": "Mist (text on navy)", "color": "#B8BFCA" },
				{ "slug": "slate", "name": "Slate (secondary text)", "color": "#3A4556" },
				{ "slug": "accent", "name": "Signal Orange (accents only)", "color": "#E5482C" },
				{ "slug": "surface", "name": "Cloud", "color": "#F5F6F8" },
				{ "slug": "line", "name": "Line", "color": "#E2E5EA" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "0.5rem" },
				{ "slug": "30", "name": "X-Small", "size": "1rem" },
				{ "slug": "40", "name": "Small", "size": "clamp(1.5rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(3rem, 7vw, 6rem)" },
				{ "slug": "70", "name": "X-Large", "size": "clamp(4rem, 9vw, 8rem)" },
				{ "slug": "80", "name": "2X-Large", "size": "clamp(5rem, 12vw, 10rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-italic.woff2" ]
						}
					]
				},
				{
					"slug": "space-grotesk",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/space-grotesk-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "System Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "X-Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X-Large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "slug": "display", "name": "Display", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|space-grotesk",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"border": { "radius": "0" },
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.75rem", "right": "1.75rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|space-grotesk",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|navy-raised",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|slate" },
				"typography": { "fontSize": "var:preset|font-size|x-small" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|space-grotesk",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|slate" },
				"typography": { "fontSize": "var:preset|font-size|x-small" }
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em",
					"fontWeight": "500"
				}
			},
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|accent", "width": "3px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "1.5rem" } }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|line" }
			},
			"core/code": {
				"typography": { "fontFamily": "var:preset|font-family|mono" }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title (full width)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
